# ---------------------------------------------------------------------------
# PH-Drama
#
# With none of these set the app boots in DEMO MODE: an in-memory catalogue and
# a signed cookie standing in for the database, so the whole UI is clickable.
# That is what the Vercel preview runs.
#
# Fill all three Supabase values in to switch to live mode.
# ---------------------------------------------------------------------------

# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the demo-mode cookies (viewer state and the staff session). Any long
# random string.
DEMO_SESSION_SECRET=

# Demo-mode passcode for the staff portal at /admin. Demo data is per-browser
# and fake, so this gates the surface, not real money. Defaults to "phdrama".
# Ignored in live mode, where staff sign in with their Supabase credentials.
DEMO_ADMIN_PASSCODE=

# Rewarded ads stay off until an ad network with server-side verification is
# chosen. See docs/BUILD_ORDER.md, Phase 8.
NEXT_PUBLIC_FLAG_REWARDED_ADS=false
